# ============================================================
# Frontend — Plataforma de Apoio a Monitoria
# ============================================================
# O backend fecha o CORS quando CORS_ORIGINS esta vazio e o .env.example dele
# aponta http://localhost:3001 — por isso o frontend roda na 3001.

# URL do backend NestJS, COM o prefixo /api.
# Usada apenas no SERVIDOR (Route Handlers, RSC, Server Actions).
# Nao tem prefixo NEXT_PUBLIC_ de proposito: o navegador nunca fala com o
# backend diretamente, sempre pelo proxy /api/backend.
API_URL=http://localhost:3000/api

# Nome do cookie de sessao (httpOnly). Trocar invalida as sessoes existentes.
SESSAO_COOKIE_NOME=monitoria_sessao

# Marca o cookie como Secure. Deixe false em desenvolvimento (http://localhost),
# true em qualquer ambiente servido por HTTPS.
COOKIE_SECURE=false
